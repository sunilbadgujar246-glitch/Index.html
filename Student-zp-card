<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>जिल्हा परिषद जळगाव - विद्यार्थी कार्ड</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(180deg, #16223F 0%, #080D1A 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
            box-sizing: border-box;
        }

        /* Rainbow Frame Card */
        .id-card {
            background: linear-gradient(135deg, #ffffff 0%, #f0f4f8 100%);
            color: #333333;
            border-radius: 24px;
            padding: 6px; /* Space for the rainbow border */
            background: linear-gradient(45deg, #FF3366, #FF9933, #FFFF33, #33CC66, #3399FF, #9933FF);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .card-inner {
            background: #ffffff;
            border-radius: 20px;
            padding: 25px 20px;
            text-align: center;
        }

        .card-header {
            font-size: 24px;
            font-weight: bold;
            color: #d63031;
            margin-bottom: 20px;
        }

        /* Photo Upload Circle */
        .photo-upload {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            margin: 0 auto 20px auto;
            background: linear-gradient(45deg, #FF9933, #33CC66, #3399FF);
            padding: 4px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            position: relative;
        }

        .photo-inner {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #e2e8f0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #718096;
            font-size: 11px;
            overflow: hidden;
        }

        .photo-inner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .photo-inner span {
            font-size: 30px;
            margin-bottom: 5px;
        }

        #file-input {
            display: none;
        }

        /* Badge Ribbon */
        .badge-ribbon {
            background: linear-gradient(90deg, #ed8936, #48bb78);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* Form Inputs */
        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #2d3748;
            font-size: 15px;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
            background-color: #f7fafc;
        }

        /* Bottom Pride Tag */
        .pride-tag {
            background: linear-gradient(90deg, #2b6cb0, #c53030);
            color: white;
            padding: 12px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            margin-top: 25px;
        }

        /* Bottom Action Buttons */
        .action-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 15px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            border-radius: 10px;
            border: none;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-download {
            background: linear-gradient(90deg, #dd6b20, #e53e3e);
        }

        .btn-clear {
            background: linear-gradient(90deg, #319795, #3182ce);
        }
    </style>
</head>
<body>

    <div class="card-container">
        <div class="id-card">
            <div class="card-inner">
                
                <div class="card-header">जिल्हा परिषद जळगाव</div>

                <div class="photo-upload" onclick="document.getElementById('file-input').click()">
                    <div class="photo-inner" id="photo-display">
                        <span>👤</span>
                        फोटो अपलोड करा<br>(Click to upload)
                    </div>
                </div>
                <input type="file" id="file-input" accept="image/*" onchange="loadPhoto(event)">

                <div class="badge-ribbon">"मी जि. प. शाळेचा विद्यार्थी"</div>

                <div class="form-group">
                    <label>नाव:</label>
                    <input type="text" id="student-name" placeholder="येथे नाव लिहा...">
                </div>

                <div class="form-group">
                    <label>पदनाम:</label>
                    <input type="text" id="student-role" placeholder="येथे पदनाम लिहा...">
                </div>

                <div class="form-group">
                    <label>मी शिकलेली जि. प. शाळा:</label>
                    <input type="text" id="school-name" placeholder="शाळेचे नाव लिहा...">
                </div>

                <div class="pride-tag">"माझी शाळा माझा अभिमान"</div>

            </div>
        </div>

        <div class="action-buttons">
            <button class="btn btn-download" onclick="alert('कार्ड डाउनलोड होत आहे...')">📥 Download Card</button>
            <button class="btn btn-clear" onclick="clearFields()">🗑️ Clear All</button>
        </div>
    </div>

    <script>
        // Javascript to handle the picture preview
        function loadPhoto(event) {
            const output = document.getElementById('photo-display');
            output.innerHTML = '<img src="' + URL.createObjectURL(event.target.files[0]) + '">';
        }

        // Javascript to clear the input boxes
        function clearFields() {
            document.getElementById('student-name').value = '';
            document.getElementById('student-role').value = '';
            document.getElementById('school-name').value = '';
            document.getElementById('photo-display').innerHTML = '<span>👤</span>फोटो अपलोड करा<br>(Click to upload)';
            document.getElementById('file-input').value = '';
        }
    </script>

</body>
</html>
